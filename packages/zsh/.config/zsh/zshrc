#!/bin/zsh
DEBUG=false

# Initialize locale and support true color in terminal and tmux
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export COLORTERM=truecolor

print_time() {
  # echo $(date +%d.%m.%y-%H:%M:%S)
  echo $(date +%H:%M:%S)
}

log() {
  $DEBUG && echo "$1" && print_time
}

# Homebrew must come before nvm/sdkman (loaded from zsh-exports) so that
# /opt/homebrew/bin does not shadow the nvm-managed node, and before compinit
# so its site-functions are on fpath.
if [[ "$OSTYPE" == "darwin"* ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

export HISTSIZE=50000
export SAVEHIST=50000
export HISTFILE="$ZDOTDIR/.zsh_history"
# export HISTTIMEFORMAT="[%F %T] "
# setopt EXTENDED_HISTORY
setopt share_history hist_ignore_dups hist_ignore_space

# some useful options (man zshoptions)
setopt autocd extendedglob nomatch menucomplete
setopt interactive_comments
stty stop undef # Disable ctrl-s to freeze terminal.
zle_highlight=('paste:none')

# beeping is annoying
unsetopt BEEP

# Useful Functions (zsh_add_completion is needed before compinit)
source "$ZDOTDIR/zsh-functions"

# completions
# Every fpath addition must happen before compinit, otherwise its completions
# are never registered.
[ -d "$ZDOTDIR/.zfunc/completion" ] && fpath+="$ZDOTDIR/.zfunc/completion"
zsh_add_completion "esc/conda-zsh-completion" false

autoload -Uz compinit
zstyle ':completion:*' menu select
zmodload zsh/complist

# Reuse the cached dump for up to 24h (fast), then rebuild it so newly
# installed completions show up
if [[ -n $ZDOTDIR/.zcompdump(#qN.mh-24) ]]; then
  compinit -C
else
  compinit
fi
_comp_options+=(globdots) # Include hidden files.

autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

# Colors
autoload -Uz colors && colors

# Normal files to source
log "loading aliases"
zsh_add_file "zsh-aliases"
log "loading exports"
zsh_add_file "zsh-exports"
log "loading vim mode"
zsh_add_file "zsh-vim-mode"
log "loading prompt"
zsh_add_file "zsh-prompt"
log "loading private keys"
zsh_add_file "zsh-private-keys"

# Key-bindings
# bindkey -s '^n' 'nvim $(fzf)^M'
# bindkey -s '^v' 'nvim\n'
bindkey "^p" up-line-or-beginning-search   # Up
bindkey "^n" down-line-or-beginning-search # Down
bindkey "^k" up-line-or-beginning-search   # Up
bindkey "^j" down-line-or-beginning-search # Down
bindkey -r "^u"
bindkey -r "^d"

# FZF
# No need this because it is installed from git repo
# git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
# ~/.fzf/install
#
# [ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh
# [ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
# [ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
# [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh

zsh_add_file "fzf.sh"
# fzf >= 0.48 ships its own shell integration; older installs fall back to the
# per-OS lookup in fzf.zsh
if (( $+commands[fzf] )) && fzf --zsh &>/dev/null; then
  source <(fzf --zsh)
else
  zsh_add_file "fzf.zsh"
fi
# export FZF_DEFAULT_COMMAND='rg --hidden -l ""'


# Environment variables set everywhere
export EDITOR="nvim"

# OS-specific configurations
if [[ "$OSTYPE" == "darwin"* ]]; then
    zsh_add_file "macos.zsh"
elif [[ -f /etc/debian_version ]]; then
    zsh_add_file "debian.zsh"
elif [[ -f /etc/arch-release ]]; then
    zsh_add_file "arch.zsh"
elif [[ -f /etc/fedora-release ]]; then
    zsh_add_file "fedora.zsh"
fi

# codex ships its own completion script. Running it costs ~100ms (node), so
# cache it and regenerate when the codex install changes.
if (( $+commands[codex] )); then
  _codex_comp="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/_codex"
  if [[ ! -s $_codex_comp || ${commands[codex]:A} -nt $_codex_comp ]]; then
    mkdir -p ${_codex_comp:h} && codex completion zsh >| $_codex_comp 2>/dev/null
  fi
  [[ -s $_codex_comp ]] && source $_codex_comp
  unset _codex_comp
fi

# Plugins
zsh_add_plugin "hlissner/zsh-autopair"

# These two MUST be sourced last
zsh_add_plugin "zsh-users/zsh-autosuggestions"
zsh_add_plugin "zsh-users/zsh-syntax-highlighting"

log "added plugins"
# For more plugins: https://github.com/unixorn/awesome-zsh-plugins
# More completions https://github.com/zsh-users/zsh-completions

# swap escape and caps (Linux only)
# setxkbmap -option caps:swapescape
