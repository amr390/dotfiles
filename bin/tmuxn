#!/bin/zsh

# Generate a unique session name
SESSION="s-${$(uuidgen):0:4}"

# Create a new detached session with a window named 'IDE'
tmux new-session -d -s "$SESSION" -n 'Lazygit'

tmux new-window -t "$SESSION" -n 'IDE'

# Split the window horizontally: 70% Left, 30% Right
tmux split-window -h -p 30 -t "$SESSION:IDE"

# Move back to the left pane and split it vertically: 70% Top, 30% Bottom
tmux select-pane -L -t "$SESSION:IDE"

tmux split-window -v -p 30 -t "$SESSION:IDE"


# Move focus back to the top-left pane
tmux select-pane -U -t "$SESSION:IDE"

sleep 0.1
# Start nvim in the top-left pane
tmux send-keys -t "$SESSION:IDE" "nvim" C-m
tmux send-keys -t "$SESSION:Lazygit" "lazygit" C-m

# Attach to the session
tmux attach-session -t "$SESSION"
